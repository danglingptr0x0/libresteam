prefix=@CMAKE_INSTALL_PREFIX@
exec_prefix=${prefix}
libdir=@CMAKE_INSTALL_FULL_LIBDIR@
includedir=@CMAKE_INSTALL_FULL_INCLUDEDIR@

Name: libresteam
Description: Steam API replacement library
Version: @PROJECT_VERSION@
Requires.private: dangling
Libs: -L${libdir} -l:@LIBRESTEAM_PC_LINK_NAME@
Cflags: -I${includedir}
